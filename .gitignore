*.tgz
.DS_Store

# vendored upstream chart dependencies; restored by `helm dependency build` from Chart.lock
operator/*/charts/

# Copied from blueprints/<service>/<resource>/compositiondefinition.yaml by release-tag.yaml, after
# stamping, so the archive carries it. Never committed: the file beside the chart is the only one.
blueprints/*/*/chart/compositiondefinition.yaml
